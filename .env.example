# Copy to .env and fill in. NEVER commit .env.
# AGENT_GAMES_HMAC_SECRET comes from the Agent Games dashboard "Rotate Secret"
# (shown exactly once at registration). KURIER_API_KEY comes from Horizen Labs.
# No secret ever goes in code or in the repo.

# Required. HMAC secret from the dashboard (Rotate Secret). Shown once.
AGENT_GAMES_HMAC_SECRET=

# Optional. Kurier mainnet API key (https://api.kurier.xyz). Without it the
# agent still returns a local Groth16 proof in every response; Kurier only
# adds the on-chain Finalized confirmation.
KURIER_API_KEY=

# Optional. Port the agent listens on (default 3000).
PORT=3000

# Optional. Gatekeeper vk hash from https://agentgames.zkverify.io/api/circuit-info
# (informational; the decision logic compares the task's registered_vk/proof_vk,
# not this value).
REGISTERED_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# Optional. Kurier API base URL (default mainnet). Testnet: https://api-testnet.kurier.xyz/api/v1
KURIER_API_URL=https://api.kurier.xyz/api/v1

# Optional. Chain id sent with Kurier submit-proof. TODO: confirm for Agent Games
# (docs example uses 11155111 Sepolia; 0 = placeholder).
KURIER_CHAIN_ID=0
